---
// Fast snabbmeny längst ner på mobilen – där tummen är.
import Icon from "./Icon.astro";
import { site, ordering } from "../data/site.js";
import { withBase } from "../lib/url";
---

<nav class="mobile-bar" aria-label="Snabbval">
  <a href={withBase("/#meny")}>
    <Icon name="slice" />
    <span>Meny</span>
  </a>
  <a href={site.phone.href}>
    <Icon name="phone" />
    <span>Ring</span>
  </a>
  <a href={withBase("/#hitta-hit")}>
    <Icon name="pin" />
    <span>Hitta hit</span>
  </a>
  <a class="mb-order" href={ordering.direct.url} data-order>
    <Icon name="bag" />
    <span>Beställ</span>
  </a>
</nav>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.7fr;
    gap: 6px;
    height: var(--mobilebar-h);
    padding: 8px 10px calc(8px + env(safe-area-inset-bottom, 0px));
    background: rgb(29 25 21 / 0.96);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 -10px 30px -12px rgb(0 0 0 / 0.45);
  }
  .mobile-bar a {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 3px;
    border-radius: 12px;
    color: var(--paper);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .mobile-bar a:active {
    background: rgb(246 238 221 / 0.1);
  }
  .mobile-bar :global(.icon) {
    width: 22px;
    height: 22px;
    color: var(--gold-light);
  }
  .mobile-bar .mb-order {
    display: flex;
    justify-content: center;
    gap: 8px;
    background: var(--tomato);
    color: #fff;
    font-size: 0.9375rem;
  }
  .mobile-bar .mb-order :global(.icon) {
    color: #fff;
  }
  @media (min-width: 768px) {
    .mobile-bar {
      display: none;
    }
  }
</style>
