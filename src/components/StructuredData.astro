---
// Strukturerad data (schema.org) så att Google kan visa adress, öppettider,
// meny och beställningsknapp direkt i sökresultaten.
import { getImage } from "astro:assets";
import logo from "../assets/brand/logo-round.png";
import { site, ordering, activePartners, mapLinks } from "../data/site.js";
import { menu, allItems, displayIngredients, commonIncludes } from "../lib/menu";

const base = Astro.site ?? new URL(Astro.url.origin);
const url = new URL("/", base).href;
const logoImg = await getImage({ src: logo, width: 512, height: 512, format: "webp" });

const DAY = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

// Prisintervall för huvudrätterna (kategorier där dricka ingår), inte tillbehör och såser
const mains = menu.categories.filter((c) => commonIncludes(c).includes("dricka")).flatMap(allItems);
const prices = mains.map((i) => i.price);

const ld = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "@id": `${url}#restaurang`,
  name: site.name,
  description: site.description,
  url,
  logo: new URL(logoImg.src, base).href,
  image: [new URL("/og.jpg", base).href],
  telephone: site.phone.href.replace("tel:", ""),
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    postalCode: site.address.postalCode.replace(/\s/g, ""),
    addressLocality: site.address.city,
    addressCountry: site.address.country,
  },
  geo: { "@type": "GeoCoordinates", latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: mapLinks.google,
  servesCuisine: ["Pizza", "Kebab", "Sallader", "Hamburgare"],
  priceRange: `${Math.min(...prices)}–${Math.max(...prices)} kr`,
  currenciesAccepted: "SEK",
  acceptsReservations: false,
  openingHoursSpecification: [
    ...site.hours.weekly.map((w) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: w.days.map((d) => `https://schema.org/${DAY[d - 1]}`),
      opens: w.open,
      closes: w.close,
    })),
    ...site.hours.special.map((s) => ({
      "@type": "OpeningHoursSpecification",
      validFrom: s.date,
      validThrough: s.date,
      opens: s.closed ? "00:00" : s.open,
      closes: s.closed ? "00:00" : s.close,
    })),
  ],
  hasMenu: {
    "@type": "Menu",
    name: "Meny",
    url: `${url}#meny`,
    inLanguage: "sv",
    hasMenuSection: menu.categories.map((cat) => ({
      "@type": "MenuSection",
      name: cat.title,
      hasMenuItem: allItems(cat).map((item) => ({
        "@type": "MenuItem",
        name: item.no ? `${item.no}. ${item.name}` : item.name,
        ...(item.ingredients?.length ? { description: displayIngredients(item, { ...cat, baseIngredients: [] }) } : {}),
        ...(item.veg ? { suitableForDiet: "https://schema.org/VegetarianDiet" } : {}),
        offers: { "@type": "Offer", price: item.price, priceCurrency: "SEK" },
      })),
    })),
  },
  potentialAction: {
    "@type": "OrderAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: ordering.direct.url,
      inLanguage: "sv",
      actionPlatform: ["https://schema.org/DesktopWebPlatform", "https://schema.org/MobileWebPlatform"],
    },
  },
  sameAs: [...Object.values(site.social).filter(Boolean), ...activePartners.map((p) => p.url)],
};

// Säker inbäddning i <script>
const json = JSON.stringify(ld).replace(/</g, "\\u003c");
---

<script type="application/ld+json" set:html={json} />
