---
import "../styles/global.css";
import { site } from "../data/site.js";
import { withBase, isDemo } from "../lib/url";
import fontDisplay from "../assets/fonts/noto-serif-display-cond.woff2?url";
import fontDisplayItalic from "../assets/fonts/noto-serif-display-cond-italic.woff2?url";
import fontBody from "../assets/fonts/archivo.woff2?url";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${site.name} – Pizza i Kalmar | Meny & beställ online`,
  description = site.description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase("/og.jpg"), Astro.site);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || isDemo) && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#f6eedd" />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="48x48" />
    <link rel="icon" href={withBase("/favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("/site.webmanifest")} />

    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontDisplayItalic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} – pizzeria på ${site.address.street} i ${site.address.city}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#meny">Hoppa till menyn</a>
    {
      isDemo && (
        <p class="demo-banner" role="note">
          <strong>Förhandsvisning</strong> av ny webbplats för {site.name} – inte restaurangens officiella sida ännu.
        </p>
      )
    }
    <slot />
  </body>
</html>
